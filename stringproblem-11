public class CompareSpaceCharacters {
    public static void main(String[] args) {
        String str1 = "Java is a programming language";
        String str2 = "I love coding in Java";

        int spaces1 = countSpaces(str1);
        int spaces2 = countSpaces(str2);

        System.out.println("Spaces in String 1: " + spaces1);
        System.out.println("Spaces in String 2: " + spaces2);

        if (spaces1 > spaces2) {
            System.out.println("String 1 has more space characters.");
        } else if (spaces2 > spaces1) {
            System.out.println("String 2 has more space characters.");
        } else {
            System.out.println("Both strings have the same number of space characters.");
        }
    }

    public static int countSpaces(String str) {
        int count = 0;
        for (int i = 0; i < str.length(); i++) {
            if (str.charAt(i) == ' ') {
                count++;
            }
        }
        return count;
    }
}
